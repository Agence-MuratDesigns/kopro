generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Utilisateur (client ou admin KOPRO)
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String
  firstName     String
  lastName      String
  phone         String?
  role          String    @default("CLIENT")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  dossiers      Dossier[]           @relation("ClientDossiers")
  assignedDossiers Dossier[]        @relation("AssignedDossiers")
  messages      Message[]
  notifications Notification[]
  documents     Document[]
  activityLogs  ActivityLog[]

  @@map("users")
}

// Dossier de rénovation
model Dossier {
  id                String    @id @default(cuid())
  reference         String    @unique
  status            String    @default("EN_COURS")
  currentStepId     String?

  // Informations projet
  projectType       String?
  projectAddress    String?
  projectCity       String?
  projectPostalCode String?
  estimatedBudget   Float?

  // Informations MaPrimeRénov
  mprNumber         String?
  mprStatus         String?
  mprAmount         Float?

  // Informations CEE
  ceeNumber         String?
  ceeStatus         String?
  ceeAmount         Float?

  // Revenus et éligibilité
  revenueCategory   String?
  householdSize     Int?

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  clientId          String
  client            User      @relation("ClientDossiers", fields: [clientId], references: [id])
  advisorId         String?
  advisor           User?     @relation("AssignedDossiers", fields: [advisorId], references: [id])

  steps             DossierStep[]
  documents         Document[]
  messages          Message[]
  notifications     Notification[]
  activityLogs      ActivityLog[]

  @@map("dossiers")
}

// Étape type (template)
model StepTemplate {
  id              String    @id @default(cuid())
  code            String    @unique
  name            String
  description     String
  order           Int
  category        String
  requiredDocs    String?
  validationRules String?
  autoValidation  Boolean   @default(false)

  dossierSteps    DossierStep[]

  @@map("step_templates")
}

// Étape d'un dossier spécifique
model DossierStep {
  id              String    @id @default(cuid())
  status          String    @default("LOCKED")
  startedAt       DateTime?
  completedAt     DateTime?
  validatedAt     DateTime?
  validatedBy     String?
  notes           String?
  blockedReason   String?

  dossierId       String
  dossier         Dossier   @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  templateId      String
  template        StepTemplate @relation(fields: [templateId], references: [id])

  documents       Document[]

  @@unique([dossierId, templateId])
  @@map("dossier_steps")
}

// Document
model Document {
  id              String    @id @default(cuid())
  name            String
  type            String
  fileName        String
  filePath        String
  fileSize        Int
  mimeType        String
  status          String    @default("PENDING")
  rejectionReason String?

  uploadedAt      DateTime  @default(now())
  validatedAt     DateTime?

  // Relations
  uploaderId      String
  uploader        User      @relation(fields: [uploaderId], references: [id])
  dossierId       String
  dossier         Dossier   @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  stepId          String?
  step            DossierStep? @relation(fields: [stepId], references: [id])

  @@map("documents")
}

// Message
model Message {
  id              String    @id @default(cuid())
  content         String
  isRead          Boolean   @default(false)
  isFromClient    Boolean
  createdAt       DateTime  @default(now())

  // Relations
  senderId        String
  sender          User      @relation(fields: [senderId], references: [id])
  dossierId       String
  dossier         Dossier   @relation(fields: [dossierId], references: [id], onDelete: Cascade)

  @@map("messages")
}

// Notification
model Notification {
  id              String    @id @default(cuid())
  type            String
  title           String
  message         String
  isRead          Boolean   @default(false)
  link            String?
  createdAt       DateTime  @default(now())

  // Relations
  userId          String
  user            User      @relation(fields: [userId], references: [id])
  dossierId       String?
  dossier         Dossier?  @relation(fields: [dossierId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

// Journal d'activité
model ActivityLog {
  id              String    @id @default(cuid())
  action          String
  details         String?
  ipAddress       String?
  createdAt       DateTime  @default(now())

  // Relations
  userId          String?
  user            User?     @relation(fields: [userId], references: [id])
  dossierId       String?
  dossier         Dossier?  @relation(fields: [dossierId], references: [id], onDelete: Cascade)

  @@map("activity_logs")
}
