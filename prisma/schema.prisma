generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Utilisateur (client, artisan ou admin KOPRO)
model User {
  id              String    @id @default(cuid())
  email           String    @unique
  password        String
  firstName       String
  lastName        String
  phone           String?
  role            String    @default("CLIENT") // CLIENT, ADMIN, ARTISAN
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  createdById     String?   // ID de l'admin qui a créé le compte
  firstLoginAt    DateTime? // Date de première connexion
  mustChangePassword Boolean @default(true) // Doit changer son mot de passe à la première connexion
  lastLoginAt     DateTime? // Dernière connexion
  isActive        Boolean   @default(true) // Compte actif ou désactivé

  // Profil client
  address         String?   // Adresse postale
  addressComplement String? // Complément d'adresse
  postalCode      String?   // Code postal
  city            String?   // Ville
  avatarUrl       String?   // URL de l'avatar

  // Champs spécifiques Artisan (utilisés si role = 'ARTISAN')
  companyName       String?   // Raison sociale
  siret             String?   // SIRET (14 chiffres)
  companyAddress    String?   // Adresse entreprise
  companyPostalCode String?   // Code postal entreprise
  companyCity       String?   // Ville entreprise
  rgeQualifications String?   // JSON array des certifications RGE

  // Préférences utilisateur
  soundEnabled        Boolean @default(true)  // Sons activés
  emailNotifications  Boolean @default(true)  // Notifications email
  pushNotifications   Boolean @default(true)  // Notifications push/interface
  preferredChannel    String  @default("BOTH") // INTERFACE, EMAIL, BOTH

  // Relations
  dossiers         Dossier[]           @relation("ClientDossiers")
  assignedDossiers Dossier[]           @relation("AssignedDossiers")
  managedDossiers  Dossier[]           @relation("ArtisanManagedDossiers") // Dossiers gérés par l'artisan
  messages         Message[]
  notifications    Notification[]
  documents        Document[]
  activityLogs     ActivityLog[]
  payments         Payment[]

  @@map("users")
}

// Dossier de rénovation
model Dossier {
  id                String    @id @default(cuid())
  reference         String    @unique
  status            String    @default("BROUILLON") // BROUILLON, EN_COURS, EN_ATTENTE, VALIDE, REFUSE, CLOTURE
  currentStep       Int       @default(2) // Étape actuelle (commence à 2 car étape 1 = création compte)
  isActive          Boolean   @default(true) // Dossier actif ou clôturé

  // Informations MaPrimeRénov - Étape 2
  mprId             String?   // Identifiant MPR (format MPR-XXXXAB)
  mprStatus         String    @default("DRAFT") // DRAFT, PENDING_REVIEW, APPROVED, REJECTED
  mprSubmittedAt    DateTime? // Date de soumission de l'identifiant
  mprLastUpdatedAt  DateTime? // Dernière modification
  mprReviewedAt     DateTime? // Date de validation/refus admin
  mprReviewMessage  String?   // Message admin en cas de rejet
  mprReviewedById   String?   // Admin qui a validé/refusé
  mprCertified      Boolean   @default(false) // Client a certifié l'identifiant

  // Infos projet - Étape 3 (nouvelle)
  projectInfoStatus       String    @default("DRAFT") // DRAFT, PENDING_REVIEW, APPROVED, REJECTED
  projectInfoSubmittedAt  DateTime? // Date de soumission
  projectInfoReviewedAt   DateTime? // Date de validation/refus admin
  projectInfoReviewMessage String?  // Message admin en cas de rejet
  projectInfoLastSavedAt  DateTime? // Dernière sauvegarde brouillon
  energyType              String?   // ELECTRICITY, GAS, FUEL, WOOD, OTHER
  housingType             String?   // HOUSE, APARTMENT
  housingSurface          Float?    // Surface en m²
  constructionYear        Int?      // Année de construction
  ownershipStatus         String?   // OWNER, TENANT

  // Paiement - Étape 4
  servicePaymentStatus      String    @default("DRAFT") // DRAFT, PENDING, SUCCEEDED, FAILED
  servicePaymentAmount      Int?      // Montant en centimes
  servicePaymentCompletedAt DateTime? // Date de paiement

  // Mandat - Étape 5
  mandatStatus      String    @default("DRAFT") // DRAFT, PENDING_REVIEW, APPROVED, REJECTED
  mandatSignedAt    DateTime? // Date de signature
  mandatMethod      String?   // MANUAL, ELECTRONIC
  mandatReviewMessage String? // Message admin en cas de rejet

  // Travaux sélectionnés - Étape 5 (JSON array)
  selectedWorks     String?   // ["ISOLATION", "HEATING", "HOT_WATER", "VENTILATION"]
  worksSelectedAt   DateTime? // Date de sélection

  // Devis - Étape 6
  quotesStatus      String    @default("DRAFT") // DRAFT, PENDING_REVIEW, APPROVED, REJECTED
  quotesSubmittedAt DateTime? // Date de soumission
  quotesReviewMessage String? // Message admin en cas de rejet

  // Démarrage travaux - Étape 7
  workStartedAt     DateTime? // Date de notification début travaux
  workStatus        String    @default("NOT_STARTED") // NOT_STARTED, IN_PROGRESS, COMPLETED

  // Factures - Étape 8
  invoicesStatus    String    @default("DRAFT") // DRAFT, PENDING_REVIEW, APPROVED, REJECTED
  invoicesSubmittedAt DateTime? // Date de soumission
  invoicesReviewMessage String? // Message admin en cas de rejet

  // Clôture - Étape 9
  closedAt          DateTime? // Date de clôture
  closedById        String?   // Admin qui a clôturé

  // Informations projet
  projectType       String?
  projectAddress    String?
  projectCity       String?
  projectPostalCode String?
  estimatedBudget   Float?

  // Informations financières
  mprAmount         Float?    // Montant MaPrimeRénov estimé
  ceeAmount         Float?    // Montant CEE estimé
  totalWorksAmount  Float?    // Montant total des travaux
  mprPaidAmount     Float?    // Montant MPR versé
  ceePaidAmount     Float?    // Montant CEE versé
  paymentStatus     String    @default("PENDING") // PENDING, IN_PROGRESS, PAID

  // Revenus et éligibilité
  revenueCategory   String?
  householdSize     Int?

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  clientId          String?   // Client qui gère son propre dossier (null si géré par artisan)
  client            User?     @relation("ClientDossiers", fields: [clientId], references: [id])
  advisorId         String?
  advisor           User?     @relation("AssignedDossiers", fields: [advisorId], references: [id])
  artisanId         String?   // Artisan qui gère ce dossier (null si client direct)
  artisan           User?     @relation("ArtisanManagedDossiers", fields: [artisanId], references: [id])

  // Infos client final (pour dossiers artisan où le client n'a pas de compte)
  endClientFirstName    String?
  endClientLastName     String?
  endClientEmail        String?
  endClientPhone        String?
  endClientAddress      String?
  endClientPostalCode   String?
  endClientCity         String?

  steps             DossierStep[]
  documents         Document[]
  messages          Message[]
  notifications     Notification[]
  activityLogs      ActivityLog[]
  mprHistory        MprHistory[]
  payments          Payment[]

  @@map("dossiers")
}

// Historique des modifications MPR (traçabilité)
model MprHistory {
  id            String    @id @default(cuid())
  dossierId     String
  dossier       Dossier   @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  previousValue String?
  newValue      String?
  action        String    // SUBMITTED, MODIFIED, APPROVED, REJECTED
  actorId       String?   // ID de l'utilisateur (client ou admin)
  actorType     String    // CLIENT, ADMIN
  message       String?   // Message associé (ex: raison du rejet)
  createdAt     DateTime  @default(now())

  @@map("mpr_history")
}

// Étape type (template) - Les 9 étapes du parcours
model StepTemplate {
  id              String    @id @default(cuid())
  code            String    @unique
  name            String
  description     String
  order           Int
  category        String
  requiredDocs    String?
  validationRules String?
  autoValidation  Boolean   @default(false)
  adminOnly       Boolean   @default(false) // Étape gérée uniquement par admin

  dossierSteps    DossierStep[]

  @@map("step_templates")
}

// Étape d'un dossier spécifique
model DossierStep {
  id              String    @id @default(cuid())
  status          String    @default("LOCKED") // LOCKED, AVAILABLE, IN_PROGRESS, PENDING_VALIDATION, VALIDATED, BLOCKED
  startedAt       DateTime?
  completedAt     DateTime?
  validatedAt     DateTime?
  validatedBy     String?
  notes           String?
  blockedReason   String?
  data            String?   // Données JSON spécifiques à l'étape

  dossierId       String
  dossier         Dossier   @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  templateId      String
  template        StepTemplate @relation(fields: [templateId], references: [id])

  documents       Document[]

  @@unique([dossierId, templateId])
  @@map("dossier_steps")
}

// Document
model Document {
  id              String    @id @default(cuid())
  name            String
  type            String    // DEVIS, FACTURE, MANDAT, ATTESTATION, etc.
  workType        String?   // ISOLATION, HEATING, HOT_WATER, VENTILATION (pour devis/factures)
  fileName        String
  filePath        String
  fileSize        Int
  mimeType        String
  status          String    @default("PENDING") // PENDING, VALIDATED, REJECTED
  rejectionReason String?

  uploadedAt      DateTime  @default(now())
  validatedAt     DateTime?

  // Relations
  uploaderId      String
  uploader        User      @relation(fields: [uploaderId], references: [id])
  dossierId       String
  dossier         Dossier   @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  stepId          String?
  step            DossierStep? @relation(fields: [stepId], references: [id])

  @@map("documents")
}

// Message
model Message {
  id              String    @id @default(cuid())
  content         String
  isRead          Boolean   @default(false)
  messageType     String    @default("CLIENT") // CLIENT, ADMIN, SYSTEM
  category        String?   // Pour les messages système: STEP_VALIDATION, STEP_REJECTION, INFO, etc.
  createdAt       DateTime  @default(now())

  // Relations
  senderId        String?   // Nullable pour les messages système
  sender          User?     @relation(fields: [senderId], references: [id])
  dossierId       String
  dossier         Dossier   @relation(fields: [dossierId], references: [id], onDelete: Cascade)

  @@map("messages")
}

// Notification
model Notification {
  id              String    @id @default(cuid())
  type            String
  title           String
  message         String
  isRead          Boolean   @default(false)
  link            String?
  createdAt       DateTime  @default(now())

  // Relations
  userId          String
  user            User      @relation(fields: [userId], references: [id])
  dossierId       String?
  dossier         Dossier?  @relation(fields: [dossierId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

// Journal d'activité
model ActivityLog {
  id              String    @id @default(cuid())
  action          String
  details         String?
  ipAddress       String?
  createdAt       DateTime  @default(now())

  // Relations
  userId          String?
  user            User?     @relation(fields: [userId], references: [id])
  dossierId       String?
  dossier         Dossier?  @relation(fields: [dossierId], references: [id], onDelete: Cascade)

  @@map("activity_logs")
}

// Paiement Stripe
model Payment {
  id                String    @id @default(cuid())
  amount            Int       // Montant en centimes (29000 = 290€)
  currency          String    @default("eur")
  status            String    @default("PENDING") // PENDING, PROCESSING, SUCCEEDED, FAILED

  stripeSessionId   String?   @unique
  stripePaymentId   String?   @unique

  description       String?
  customerEmail     String?

  createdAt         DateTime  @default(now())
  paidAt            DateTime?
  failedAt          DateTime?
  errorMessage      String?

  // Relations
  dossierId         String
  dossier           Dossier   @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  userId            String?
  user              User?     @relation(fields: [userId], references: [id])

  @@map("payments")
}
