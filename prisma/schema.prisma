generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Utilisateur (client ou admin KOPRO)
model User {
  id              String    @id @default(cuid())
  email           String    @unique
  password        String
  firstName       String
  lastName        String
  phone           String?
  role            String    @default("CLIENT")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  createdById     String?   // ID de l'admin qui a créé le compte
  firstLoginAt    DateTime? // Date de première connexion
  mustChangePassword Boolean @default(true) // Doit changer son mot de passe à la première connexion

  // Relations
  dossiers         Dossier[]           @relation("ClientDossiers")
  assignedDossiers Dossier[]           @relation("AssignedDossiers")
  messages         Message[]
  notifications    Notification[]
  documents        Document[]
  activityLogs     ActivityLog[]

  @@map("users")
}

// Dossier de rénovation
model Dossier {
  id                String    @id @default(cuid())
  reference         String    @unique
  status            String    @default("BROUILLON") // BROUILLON, EN_COURS, EN_ATTENTE, VALIDE, REFUSE, TERMINE
  currentStep       Int       @default(2) // Étape actuelle (commence à 2 car étape 1 = création compte)

  // Informations MaPrimeRénov - Étape 2
  mprId             String?   // Identifiant MPR (format MPR-XXXXAB)
  mprStatus         String    @default("DRAFT") // DRAFT, PENDING_REVIEW, APPROVED, REJECTED
  mprSubmittedAt    DateTime? // Date de soumission de l'identifiant
  mprLastUpdatedAt  DateTime? // Dernière modification
  mprReviewedAt     DateTime? // Date de validation/refus admin
  mprReviewMessage  String?   // Message admin en cas de rejet
  mprReviewedById   String?   // Admin qui a validé/refusé

  // Informations projet
  projectType       String?
  projectAddress    String?
  projectCity       String?
  projectPostalCode String?
  estimatedBudget   Float?

  // Informations financières
  mprAmount         Float?    // Montant MaPrimeRénov estimé
  ceeAmount         Float?    // Montant CEE estimé

  // Travaux sélectionnés (JSON array)
  selectedWorks     String?   // ["ISOLATION", "CHAUFFAGE", "EAU_CHAUDE", "VENTILATION"]

  // Revenus et éligibilité
  revenueCategory   String?
  householdSize     Int?

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  clientId          String    @unique // Un client = un dossier
  client            User      @relation("ClientDossiers", fields: [clientId], references: [id])
  advisorId         String?
  advisor           User?     @relation("AssignedDossiers", fields: [advisorId], references: [id])

  steps             DossierStep[]
  documents         Document[]
  messages          Message[]
  notifications     Notification[]
  activityLogs      ActivityLog[]
  mprHistory        MprHistory[]

  @@map("dossiers")
}

// Historique des modifications MPR (traçabilité)
model MprHistory {
  id            String    @id @default(cuid())
  dossierId     String
  dossier       Dossier   @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  previousValue String?
  newValue      String?
  action        String    // SUBMITTED, MODIFIED, APPROVED, REJECTED
  actorId       String?   // ID de l'utilisateur (client ou admin)
  actorType     String    // CLIENT, ADMIN
  message       String?   // Message associé (ex: raison du rejet)
  createdAt     DateTime  @default(now())

  @@map("mpr_history")
}

// Étape type (template) - Les 8 étapes du parcours
model StepTemplate {
  id              String    @id @default(cuid())
  code            String    @unique
  name            String
  description     String
  order           Int
  category        String
  requiredDocs    String?
  validationRules String?
  autoValidation  Boolean   @default(false)
  adminOnly       Boolean   @default(false) // Étape gérée uniquement par admin

  dossierSteps    DossierStep[]

  @@map("step_templates")
}

// Étape d'un dossier spécifique
model DossierStep {
  id              String    @id @default(cuid())
  status          String    @default("LOCKED") // LOCKED, AVAILABLE, IN_PROGRESS, PENDING_VALIDATION, VALIDATED, BLOCKED
  startedAt       DateTime?
  completedAt     DateTime?
  validatedAt     DateTime?
  validatedBy     String?
  notes           String?
  blockedReason   String?
  data            String?   // Données JSON spécifiques à l'étape

  dossierId       String
  dossier         Dossier   @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  templateId      String
  template        StepTemplate @relation(fields: [templateId], references: [id])

  documents       Document[]

  @@unique([dossierId, templateId])
  @@map("dossier_steps")
}

// Document
model Document {
  id              String    @id @default(cuid())
  name            String
  type            String
  fileName        String
  filePath        String
  fileSize        Int
  mimeType        String
  status          String    @default("PENDING")
  rejectionReason String?

  uploadedAt      DateTime  @default(now())
  validatedAt     DateTime?

  // Relations
  uploaderId      String
  uploader        User      @relation(fields: [uploaderId], references: [id])
  dossierId       String
  dossier         Dossier   @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  stepId          String?
  step            DossierStep? @relation(fields: [stepId], references: [id])

  @@map("documents")
}

// Message
model Message {
  id              String    @id @default(cuid())
  content         String
  isRead          Boolean   @default(false)
  isFromClient    Boolean
  createdAt       DateTime  @default(now())

  // Relations
  senderId        String
  sender          User      @relation(fields: [senderId], references: [id])
  dossierId       String
  dossier         Dossier   @relation(fields: [dossierId], references: [id], onDelete: Cascade)

  @@map("messages")
}

// Notification
model Notification {
  id              String    @id @default(cuid())
  type            String
  title           String
  message         String
  isRead          Boolean   @default(false)
  link            String?
  createdAt       DateTime  @default(now())

  // Relations
  userId          String
  user            User      @relation(fields: [userId], references: [id])
  dossierId       String?
  dossier         Dossier?  @relation(fields: [dossierId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

// Journal d'activité
model ActivityLog {
  id              String    @id @default(cuid())
  action          String
  details         String?
  ipAddress       String?
  createdAt       DateTime  @default(now())

  // Relations
  userId          String?
  user            User?     @relation(fields: [userId], references: [id])
  dossierId       String?
  dossier         Dossier?  @relation(fields: [dossierId], references: [id], onDelete: Cascade)

  @@map("activity_logs")
}
